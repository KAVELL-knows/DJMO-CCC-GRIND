def check_length(L, K, houses):

    diameter = 2 * L
    num_houses = len(houses)
    
    for i in range(num_houses):
        hydrants_used = 1
        coverage_end = houses[i] + diameter
        
        for j in range(1, num_houses):
            current_house_idx = (i + j) % num_houses
            current_house_pos = houses[current_house_idx]
            
            if current_house_pos < houses[i]:
                current_house_pos += 1000000
                
            if current_house_pos > coverage_end:
                hydrants_used += 1
                coverage_end = current_house_pos + diameter

        if hydrants_used <= K:
            return True
            
    return False

n = int(input())

houses = []
for i in range(n):
    houses.append(int(input()))

k = int(input())

houses.sort()

low = 0
high = 1000000
answer = high

while low <= high:
    mid = (low + high) // 2 
    
    if check_length(mid, k, houses):
        answer = mid      
        high = mid - 1 
    else:
        low = mid + 1    

print(answer)
