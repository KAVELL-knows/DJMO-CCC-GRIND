#CCC '97 S2 - Nasty Numbers
t = int(input())
for i in range(t): 
    add = []
    subtract = []
    possible = False

    n = int(input())
    end = int(n ** 0.5) 
    for i in range(1, end + 1): 
        if n % i == 0:
            total = i + (n // i)
            difference = abs((n // i) - i) 
            add.append(total)
            subtract.append(difference)
            
            for j in add:
                if j in subtract:
                    possible = True
                    break

    if possible:
        print(f"{n} is nasty")
    else:
        print(f"{n} is not nasty")
