#CCC '06 J2 - Roll the Dice

m = int(input())
n = int(input())
count = 0

for i in range(1, n+1):
    for j in range(1, m+1):
        if i + j == 10:
            count += 1 
        else:
            count = count + 0 
if count == 1:
    print("There is 1 way to get the sum 10.")
else: 
    print(f"There are {count} ways to get the sum 10.")
