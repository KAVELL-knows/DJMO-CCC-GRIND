#CCC '02 S2 - Fraction Action
n = int(input())
p = int(input())
highest = 0
if n % p == 0:
    print(n // p)
else:
    q = n // p
    r = n % p   
    for i in range(1, r + 1):
        if r % i == 0 and p % i == 0:
            highest = i 

    p = p // highest
    r = r // highest

    if q == 0:
        print(f"{r}/{p}")
    else:
        print(f"{q} {r}/{p}")
