s = ['A', 'B', 'C', 'D', 'E']
while True:
    b = int(input())
    n = int(input())
    if b == 1:
        for i in range(n):
            s = s[1:] + [s[0]]
    elif b == 2:
        for i in range(n):
            s = [s[-1]] + s[:-1]
    elif b == 3:
        for i in range(n):
            s = [s[1], s[0]] + s[2:]
    elif b == 4:
        break
print(*s)
