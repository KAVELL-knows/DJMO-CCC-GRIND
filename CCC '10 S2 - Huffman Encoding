#CCC '10 S2 - Huffman Encoding
n = int(input())
code_book = {}
for i in range(n):
    x, y = input().split()
    code_book[y] = x 
nums = input()
current_bits = ""  
for i in nums:
    current_bits += i
    if current_bits in code_book:
        print(code_book[current_bits], end="")  
        current_bits = ""  
print()
