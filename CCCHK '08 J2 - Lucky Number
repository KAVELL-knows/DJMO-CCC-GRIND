t = int(input())

for _ in range(t):

    num_str = input()

    if num_str == "0":
        print(0)
    else:
        while len(num_str) > 1:
            total = 0

            for char in num_str:
                total += int(char)

            num_str = str(total)
            
        print(num_str)
