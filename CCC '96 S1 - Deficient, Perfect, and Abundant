n = int(input())
for num in range(n):
    x = int(input())
    count = 0
    for div in range(1, x):
        if x % div == 0:
            count = count + div
        else:
            count = count + 0 
    if count > x:
        print(x, "is an abundant number.")
    elif count < x: 
        print(x, "is a deficient number.")
    else:
        print(x, "is a perfect number.")
