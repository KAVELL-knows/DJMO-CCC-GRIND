#CCC '03 J2 - Picture Perfect
while True:
    x = int(input())
    first = 0 
    second = 0
    if x == 0:
        break 
    elif x == 1:
        print(f"Minimum perimeter is 4 with dimensions 1 x 1")
    elif x == 2:
        print(f"Minimum perimeter is 6 with dimensions 2 x 1")
    elif x == 3:
        print(f"Minimum perimeter is 8 with dimensions 3 x 1")
    elif x == 4:
        print(f"Minimum perimeter is 8 with dimensions 2 x 2")
    elif x == 5:
        print(f"Minimum perimeter is 12 with dimensions 1 x 5")
    elif x == 7:
        print(f"Minimum perimeter is 14 with dimensions 1 x 7")
    else:
        perimeter = 999999999
        for i in range(1, x+1):
            if x % i == 0:
                a = i 
                b = x // i 
                if (a+b) < perimeter:
                    perimeter = (a + b)
                    first = a 
                    second = b 
        if first +  second == 0:
            print(f"Minimum perimeter is {2* perimeter} with dimensions {x} x 1")
        else:
            print(f"Minimum perimeter is {2* perimeter} with dimensions {first} x {second}")


