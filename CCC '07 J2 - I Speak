CCC '07 J2 - I Speak
b = {'CU': 'see you', ':-)': "I'm happy",
    ':-(': "I'm unhappy", ';-)': 'wink', ':-P': 'stick out my tongue', 
    '(~.~)': 'sleepy', 'TA': 'totally awesome', 
    'CCC': 'Canadian Computing Competition',
    'CUZ': 'because', 'TY': 'thank-you', "YW": "you're welcome",
    'TTYL': 'talk to you later'}
while True:
    n = input()
    if n in b:
        print(b[n])
    else:
        print(n)
    if n == "TTYL":
        break
