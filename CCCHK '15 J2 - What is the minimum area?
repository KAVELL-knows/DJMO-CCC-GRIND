#CCCHK '15 J2 - What is the minimum area?

n = int(input())

points = []
for i in range(n):
    x, y = map(int, input().split())
    points.append((x, y))

min_side_length = float('inf')

for i in range(n):
    x1, y1 = points[i]
     
    for j in range(i + 1, n):
        x2, y2 = points[j]
        
        dx = abs(x1 - x2)
        dy = abs(y1 - y2)
        
        current_side = max(dx, dy)
        
        if current_side < min_side_length:
            min_side_length = current_side

min_area = min_side_length * min_side_length
print(min_area)
