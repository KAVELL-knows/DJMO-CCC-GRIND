#CCC '07 J3 - Deal or No Deal Calculator
n = int(input())
count = 0
z = 1691600
for i in range(n):
    x = int(input())
    if x == 1:
        count = count + 100
    elif x == 2 :
        count = count + 500
    elif x == 3 :
        count = count + 1000
    elif x == 4 :
        count = count + 5000
    elif x == 5 :
        count += 10000
    elif x == 6 :
        count = count + 25000
    elif x == 7 :
        count = count + 50000
    elif x == 8 :
        count = count + 100000
    elif x == 9 :
        count = count + 500000
    elif x == 10 :
        count = count + 1000000
    else:
        count = count + 0
y = int(input())
remaining = (z - count) / (10 - n)
if remaining > y:
    print("no deal")
else: 
    print("deal")
